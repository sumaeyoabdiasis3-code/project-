@using PFDETBM.Helpers
@model IEnumerable<PFDETBM.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="dashboard-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Notifications</h1>
            <p class="text-muted mb-0">Budget alerts and savings milestones.</p>
        </div>
        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                <button type="submit" class="btn btn-outline-primary">Mark all as read</button>
            </form>
        }
    </div>

    <div class="card dashboard-card">
        <div class="card-body">
            @if (Model.Any())
            {
                @foreach (var note in Model)
                {
                    var severity = NotificationDisplay.Severity(note.Title);
                    var icon = NotificationDisplay.Icon(severity);
                    <div class="notification-item @(note.IsRead ? "" : "fw-semibold")">
                        <div class="notification-icon severity-@severity">@icon</div>
                        <div class="flex-fill">
                            <div class="notification-title">@note.Title</div>
                            <div class="notification-message">@note.Message</div>
                        </div>
                        <div class="text-end">
                            <div class="notification-time mb-1">@note.CreatedAt.ToString("MMM d, yyyy h:mm tt")</div>
                            @if (!note.IsRead)
                            {
                                <form asp-action="MarkRead" asp-route-id="@note.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Mark read</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <span class="empty-icon">✅</span>
                    No notifications yet. We'll let you know about budget alerts and savings milestones here.
                </div>
            }
        </div>
    </div>
</div>
