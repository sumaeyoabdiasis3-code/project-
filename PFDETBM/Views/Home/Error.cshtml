@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h1 class="display-4">An error occurred</h1>
                    <p class="lead text-muted">Sorry, an unexpected error has occurred. Please try again or contact support.</p>
                    <a class="btn btn-primary" href="@Url.Action("Index", "Dashboard")">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
