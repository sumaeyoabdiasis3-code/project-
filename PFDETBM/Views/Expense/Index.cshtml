@model IEnumerable<PFDETBM.Models.Expense>
@{
    ViewData["Title"] = "Expenses";
}

<div class="dashboard-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Expenses</h1>
            <p class="text-muted mb-0">Track and manage every expense entry.</p>
        </div>
        <a asp-action="Create" class="btn btn-danger">+ Add Expense</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card dashboard-card mb-4">
        <div class="card-body">
            <form method="get" class="d-flex flex-column flex-sm-row gap-2">
                <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by category or description..." />
                <button type="submit" class="btn btn-outline-primary">Search</button>
            </form>
        </div>
    </div>

    <div class="card dashboard-card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>Date</th>
                                <th>Category</th>
                                <th>Payment Method</th>
                                <th>Description</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var expense in Model)
                            {
                                <tr>
                                    <td class="text-muted small">@expense.Date.ToString("MMM d, yyyy")</td>
                                    <td>@(expense.Category?.Name ?? "Uncategorized")</td>
                                    <td>@expense.PaymentMethod</td>
                                    <td>@expense.Description</td>
                                    <td class="text-end amount-negative">-@expense.Amount.ToString("C")</td>
                                    <td class="text-end">
                                        <a asp-action="Edit" asp-route-id="@expense.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                        <form asp-action="Delete" asp-route-id="@expense.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this expense entry?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-semibold">Total</td>
                                <td class="text-end fw-semibold amount-negative">@(((decimal)ViewData["Total"]!).ToString("C"))</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <span class="empty-icon">💳</span>
                    No expenses recorded yet. <a asp-action="Create">Add your first expense entry</a>.
                </div>
            }
        </div>
    </div>
</div>
