@model IEnumerable<PFDETBM.Models.SavingsGoal>
@{
    ViewData["Title"] = "Savings Goals";
}

<div class="dashboard-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Savings Goals</h1>
            <p class="text-muted mb-0">Set targets and track your progress toward them.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Set Goal</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.Any())
    {
        <div class="row g-3">
            @foreach (var goal in Model)
            {
                var progress = goal.TargetAmount == 0 ? 0 : Math.Min(100, Math.Round((double)(goal.CurrentAmount / goal.TargetAmount) * 100, 0));
                var remaining = Math.Max(0, goal.TargetAmount - goal.CurrentAmount);
                <div class="col-lg-4 col-md-6">
                    <div class="card dashboard-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="savings-goal-title fs-5">@goal.Title</div>
                                    <div class="savings-goal-meta">Target: @goal.TargetDate.ToString("MMM d, yyyy")</div>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">⋮</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@goal.Id">Edit</a></li>
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@goal.Id" method="post" onsubmit="return confirm('Delete this savings goal?');">
                                                <button type="submit" class="dropdown-item text-danger">Delete</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>@goal.CurrentAmount.ToString("C") of @goal.TargetAmount.ToString("C")</span>
                                <span>@progress%</span>
                            </div>
                            <div class="progress mb-2">
                                <div class="progress-bar bg-primary" style="width:@progress%;"></div>
                            </div>
                            <div class="small text-muted mb-3">@remaining.ToString("C") remaining</div>

                            <form asp-action="AddSavings" method="post" class="d-flex gap-2">
                                <input type="hidden" name="GoalId" value="@goal.Id" />
                                <input type="number" name="Amount" step="0.01" min="0.01" class="form-control form-control-sm" placeholder="Amount" required />
                                <button type="submit" class="btn btn-sm btn-success text-nowrap">Add</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="empty-state">
                    <span class="empty-icon">🎯</span>
                    No savings goals yet. <a asp-action="Create">Set your first goal</a>.
                </div>
            </div>
        </div>
    }
</div>
