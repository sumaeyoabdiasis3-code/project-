@model PFDETBM.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
    var months = Enumerable.Range(1, 12).Select(m => new { Value = m, Text = new DateTime(2000, m, 1).ToString("MMMM") });
    var years = Enumerable.Range(DateTime.Now.Year - 4, 5);
}

<div class="dashboard-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Reports</h1>
            <p class="text-muted mb-0">Monthly income, expense, budget and savings performance.</p>
        </div>
        <form method="get" class="d-flex gap-2">
            <select name="month" class="form-select">
                @foreach (var m in months)
                {
                    <option value="@m.Value" selected="@(m.Value == Model.Month)">@m.Text</option>
                }
            </select>
            <select name="year" class="form-select">
                @foreach (var y in years)
                {
                    <option value="@y" selected="@(y == Model.Year)">@y</option>
                }
            </select>
            <button type="submit" class="btn btn-primary text-nowrap">View</button>
        </form>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card stat-card stat-card-green p-3">
                <small class="text-muted">Total Income — @Model.MonthLabel</small>
                <h4 class="mb-0 amount-positive">@Model.TotalIncome.ToString("C")</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card stat-card-red p-3">
                <small class="text-muted">Total Expenses — @Model.MonthLabel</small>
                <h4 class="mb-0 amount-negative">@Model.TotalExpenses.ToString("C")</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card stat-card-purple p-3">
                <small class="text-muted">Net Savings — @Model.MonthLabel</small>
                <h4 class="mb-0">@Model.NetSavings.ToString("C")</h4>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h6 class="mb-3">Income by Source</h6>
                    @if (Model.IncomeBySource.Any())
                    {
                        <ul class="legend-list">
                            @foreach (var slice in Model.IncomeBySource)
                            {
                                <li class="legend-row">
                                    <span class="legend-label"><span class="legend-dot" style="background:@slice.Color;"></span>@slice.Name</span>
                                    <span><span class="legend-value">@slice.Percent%</span> <span class="legend-percent">(@slice.Amount.ToString("C"))</span></span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="empty-state"><span class="empty-icon">💵</span>No income recorded for @Model.MonthLabel.</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h6 class="mb-3">Expenses by Category</h6>
                    @if (Model.ExpenseByCategory.Any())
                    {
                        <ul class="legend-list">
                            @foreach (var slice in Model.ExpenseByCategory)
                            {
                                <li class="legend-row">
                                    <span class="legend-label"><span class="legend-dot" style="background:@slice.Color;"></span>@slice.Name</span>
                                    <span><span class="legend-value">@slice.Percent%</span> <span class="legend-percent">(@slice.Amount.ToString("C"))</span></span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="empty-state"><span class="empty-icon">🧾</span>No expenses recorded for @Model.MonthLabel.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h6 class="mb-3">Budget Performance — @Model.MonthLabel</h6>
                    @if (Model.BudgetPerformance.Any())
                    {
                        @foreach (var item in Model.BudgetPerformance)
                        {
                            var barColor = item.PercentUsed >= 100 ? "#dc2626" : item.PercentUsed >= 80 ? "#f59e0b" : "#16a34a";
                            <div class="budget-progress-item">
                                <div class="budget-progress-head">
                                    <span class="budget-progress-cat"><span class="budget-dot" style="background:@item.Color;"></span>@item.CategoryName</span>
                                    <span class="budget-progress-amounts">@item.Spent.ToString("C") / @item.BudgetAmount.ToString("C")</span>
                                </div>
                                <div class="progress">
                                    <div class="progress-bar" style="width:@(Math.Min(item.PercentUsed, 100))%; background:@barColor;"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state"><span class="empty-icon">📊</span>No budgets set for @Model.MonthLabel.</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-body">
                    <h6 class="mb-3">Savings Report</h6>
                    @if (Model.SavingsGoals.Any())
                    {
                        @foreach (var goal in Model.SavingsGoals)
                        {
                            var progress = goal.TargetAmount == 0 ? 0 : Math.Min(100, Math.Round((double)(goal.CurrentAmount / goal.TargetAmount) * 100, 0));
                            <div class="savings-goal-item">
                                <div class="savings-goal-icon">🎯</div>
                                <div class="savings-goal-info">
                                    <div class="savings-goal-title">@goal.Title</div>
                                    <div class="savings-goal-meta">@goal.CurrentAmount.ToString("C") / @goal.TargetAmount.ToString("C")</div>
                                    <div class="progress mt-1">
                                        <div class="progress-bar bg-primary" style="width:@progress%;"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state"><span class="empty-icon">🎯</span>No savings goals yet.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
