@model PFDETBM.ViewModels.AdminStatsViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<div class="dashboard-page">
    <div class="mb-4">
        <h1 class="mb-1">Admin Panel</h1>
        <p class="text-muted mb-0">System-wide statistics across all users.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card stat-card stat-card-blue p-3">
                <small class="text-muted">Total Users</small>
                <h3 class="mb-0">@Model.TotalUsers</h3>
                <small class="text-muted">@Model.TotalAdmins admin(s)</small>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stat-card stat-card-green p-3">
                <small class="text-muted">Total Income (all users)</small>
                <h3 class="mb-0 amount-positive">@Model.TotalIncomeAllUsers.ToString("C")</h3>
                <small class="text-muted">@Model.TotalIncomeEntries entries</small>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stat-card stat-card-red p-3">
                <small class="text-muted">Total Expenses (all users)</small>
                <h3 class="mb-0 amount-negative">@Model.TotalExpensesAllUsers.ToString("C")</h3>
                <small class="text-muted">@Model.TotalExpenseEntries entries</small>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stat-card stat-card-purple p-3">
                <small class="text-muted">Categories</small>
                <h3 class="mb-0">@Model.TotalCategories</h3>
                <small class="text-muted">@Model.TotalBudgets budgets &middot; @Model.TotalSavingsGoals goals</small>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card dashboard-card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1">Manage Users</h6>
                        <p class="text-muted mb-0 small">View users and toggle admin access.</p>
                    </div>
                    <a asp-action="Users" class="btn btn-primary">Open</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card dashboard-card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1">Manage Categories</h6>
                        <p class="text-muted mb-0 small">Add, edit or remove income/expense categories.</p>
                    </div>
                    <a asp-action="Categories" class="btn btn-primary">Open</a>
                </div>
            </div>
        </div>
    </div>
</div>
