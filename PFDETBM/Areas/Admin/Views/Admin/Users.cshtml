@model List<PFDETBM.ViewModels.AdminUserRow>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="dashboard-page">
    <div class="mb-4">
        <h1 class="mb-1">Manage Users</h1>
        <p class="text-muted mb-0">Grant or revoke admin access.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card dashboard-card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr class="text-muted small">
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.IsAdmin)
                                    {
                                        <span class="badge-income">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge-expense" style="background:#dbeafe;color:#1d4ed8;">User</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="ToggleRole" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Change role for @user.Email?');">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            @(user.IsAdmin ? "Revoke Admin" : "Make Admin")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
